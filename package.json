{
  "name": "codex-bridge",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3",
    "ultracite": "7.0.11"
  },
  "scripts": {
    "dev": "bun run index.ts",
    "dev:dashboard": "NODE_OPTIONS=--use-system-ca bun run --cwd dashboard dev",
    "build:dashboard": "bun run --cwd dashboard build",
    "start": "bun run index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "smoke:e2e": "bun run scripts/e2e-smoke.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.14",
    "elysia": "^1.4.26"
  }
}
